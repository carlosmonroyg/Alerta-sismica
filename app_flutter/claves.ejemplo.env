# Plantilla de valores propios del despliegue. Copiar a claves.env y rellenar:
#
#     cp claves.ejemplo.env claves.env
#
# claves.env está excluido del repositorio y nunca se sube. Esta plantilla sí
# se sube, para que cualquiera sepa qué hace falta sin ver ningún valor real.

# URL del servidor propio, la que imprime server/desplegar.sh al publicar.
# Vacío = la app funciona sola contra los catálogos (SGC/USGS/EMSC).
SERVIDOR_URL=

# Firebase, para las notificaciones push. Los cuatro salen del archivo
# google-services.json que entrega la consola de Firebase:
#   FIREBASE_PROJECT_ID → project_info.project_id
#   FIREBASE_SENDER_ID  → project_info.project_number
#   FIREBASE_APP_ID     → client[0].client_info.mobilesdk_app_id
#   FIREBASE_API_KEY    → client[0].api_key[0].current_key
# Vacíos = la app compila y funciona igual, pero sin push.
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
